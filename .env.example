DATABASE_URL=postgresql://porter:porter@localhost:5432/porter
MOCKAPP_URL=http://localhost:9200
FLOWS_DIR=flows
USE_BROWSER=0
HEADLESS=1
SUBMIT_TIMEOUT=8
STEP_DELAY=0
# 记录认领租约秒数（崩溃接管阈值）
LEASE_SECONDS=60
# 证据确认宽限期：提交后多少秒内不做"未受理"判定
RECONCILE_GRACE_SECONDS=30
# 证据确认连续失败多少次后转人工处置
MAX_RECONCILE_ATTEMPTS=5

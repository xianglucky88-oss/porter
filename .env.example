DATABASE_URL=postgresql://porter:porter@localhost:5432/porter
MOCKAPP_URL=http://localhost:9200
FLOWS_DIR=flows

# 驱动选择：0=HTTP（默认），1=浏览器
USE_BROWSER=0
HEADLESS=1

# 浏览器不可用时的降级：off=直接失败并归因 environment；http=用 HTTP 驱动补跑并标记 degraded
BROWSER_FALLBACK=off

# 单轮最多尝试次数。默认 1；仅在 submit 之前失败且失败可重试时才会真正重试。
RUN_MAX_ATTEMPTS=1

# 超时（秒）
SUBMIT_TIMEOUT=8
STEP_DELAY=0
BROWSER_LAUNCH_TIMEOUT=30
BROWSER_NAVIGATION_TIMEOUT=15
BROWSER_SESSION_TIMEOUT=300

# 浏览器并发会话与排队
BROWSER_MAX_SESSIONS=2
BROWSER_QUEUE_TIMEOUT=30

# 沙箱与共享内存：auto 按 uid / user namespace / /dev/shm 大小自动判定
BROWSER_SANDBOX=auto
BROWSER_DEV_SHM=auto
BROWSER_MIN_SHM_MB=256
# 额外 Chromium 启动参数（空格分隔）
BROWSER_EXTRA_ARGS=

# 失败产物（截图/trace）默认关闭：可能含业务数据
BROWSER_ARTIFACTS=off

# 运行数据目录：容器内由 compose 挂成 mode=0700 的 tmpfs
PORTER_RUNTIME_DIR=/run/porter
# 浏览器预检结果的有效期（秒）；过期后 /readyz 会在后台重探
BROWSER_PROBE_TTL=30
# 就绪检查里探测目标系统的超时（秒）
READY_TARGET_TIMEOUT=3

# 管理接口（/admin/reset-batch），生产建议设为 0
ENABLE_ADMIN=1
# 追加需要脱敏的字段名（逗号分隔）；命中后其值在证据与错误信息中打码
REDACT_KEYS=

# 镜像标签 / 回滚标识
PORTER_BUILD=dev
